# Exemplo de arquivo .env para o MeOrganiza
# Copie este arquivo para .env e preencha com suas chaves de API

# OpenAI API
VITE_OPENAI_API_KEY=sua-chave-openai-aqui
VITE_OPENAI_MODEL=gpt-4o
VITE_OPENAI_ENDPOINT=https://api.openai.com/v1/chat/completions

# Gemini API
VITE_GEMINI_API_KEY=sua-chave-gemini-aqui
VITE_GEMINI_MODEL=gemini-1.5-pro
VITE_GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models

# Modelo padrão a ser usado (openai ou gemini)
VITE_AI_MODEL=openai 